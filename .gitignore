# Terraform local artifacts
**/.terraform/
*.tfstate
*.tfstate.*
*.plan
*.tfplan
**/environments/*.tfvars
!**/environments/*.tfvars.example

# Node
node_modules/

# Env files
.env
.env.*
!*.example
!docker/.env.ops.prod
docker/.env.ops.local

# Rendered at deploy from config.prod.yml.tpl; contains the SMTP password
docker/alertmanager/config.prod.yml

# Local OpenBao unseal key, read by scripts/local-openbao-unseal.sh
docker/.openbao-local-unseal-key

# OS/editor
.DS_Store
.vscode/
.idea/

# Logs
*.log

# Claude Code scratch worktrees. These are local git worktrees; committing
# one records a gitlink with no .gitmodules entry, which makes every
# actions/checkout post-cleanup fail with "No url found for submodule path".
.claude/worktrees/
