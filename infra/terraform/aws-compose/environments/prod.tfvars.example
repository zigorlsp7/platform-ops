# Copy to prod.tfvars and fill with your values.
aws_region = "eu-west-1"

project     = "platform-ops"
environment = "prod"

# Optional custom names.
# deploy_bucket_name       = "platform-ops-prod-deploy-yourcompany"
# ecr_api_repository_name  = "platform-ops/prod/api"
# ecr_web_repository_name  = "platform-ops/prod/web"

# Cheapest practical starting point for this compose stack.
instance_type = "t3.large"

# Set true only if you need SSH. Prefer SSM Session Manager.
enable_ssh        = false
ssh_ingress_cidrs = []
key_name          = ""

# If this is the first OIDC setup in the account, set true.
# If an OIDC provider already exists in IAM, keep false and set github_oidc_provider_arn.
create_github_oidc_provider = false
github_oidc_provider_arn    = "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"

# Repo allowed to assume the deploy role.
github_repository  = "your-org/platform-ops"
github_environment = "production"

# Dedicated kini deploy role + repositories.
kini_github_repository        = "your-org/kini"
kini_github_environment       = "production"
kini_ecr_api_repository_name  = "kini/prod/api"
kini_ecr_web_repository_name  = "kini/prod/web"
kini_ssm_app_parameter_prefix = "/kini/prod/app"

# Dedicated cv deploy role + repositories.
cv_github_repository         = "your-org/cv"
cv_github_repository_id_path = "your-org@000000000/cv@0000000000"
cv_github_environment        = "production"
cv_ecr_api_repository_name   = "cv/prod/api"
cv_ecr_web_repository_name   = "cv/prod/web"
cv_ssm_app_parameter_prefix  = "/cv/prod/app"

# Dedicated gpool deploy role + repositories.
gpool_github_repository        = "your-org/gpool"
gpool_github_environment       = "production"
gpool_ecr_api_repository_name  = "gpool/prod/api"
gpool_ecr_web_repository_name  = "gpool/prod/web"
gpool_ssm_app_parameter_prefix = "/gpool/prod/app"

# Dedicated notifications deploy role + repository.
notifications_github_repository        = "your-org/notifications"
notifications_github_environment       = "production"
notifications_ecr_api_repository_name  = "notifications/prod/api"
notifications_ssm_app_parameter_prefix = "/notifications/prod/app"

# Parameter prefixes consumed by scripts/prod-deploy-remote.sh.
ssm_ops_parameter_prefix = "/platform-ops/prod/ops"

power_schedule_enabled  = false
power_schedule_timezone = "Europe/Madrid"
power_off_schedule      = "cron(0 1 * * ? *)"
power_on_schedule       = "cron(0 8 * * ? *)"
