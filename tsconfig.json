{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["vitest/globals", "node"]
  },
  // Only the framework-free half of the kit.
  //
  // `nest.ts`, `fastify.ts`, `next.ts` and `tracing.ts` need their frameworks'
  // type definitions, and installing NestJS, Fastify, Next and the OpenTelemetry
  // SDK here — in a repository that ships no application — to typecheck four
  // adapters would be a large node_modules for very little. Those files are
  // typechecked in every consumer repo, which is where the framework actually
  // is; `verify-standards.sh` guarantees the copies are identical.
  //
  // What is checked here is the part with the security-critical logic and the
  // unit tests: label normalisation, ingest validation, the registry.
  "include": [
    "packages/observability/rum-metrics.ts",
    "packages/observability/rum-metrics.test.ts",
    "packages/observability/rum-ingest.ts",
    "packages/observability/rum-client.ts",
    "packages/observability/metrics.registry.ts",
    "packages/observability/feature-flags.ts",
    "packages/observability/feature-flags.test.ts"
  ],
  "exclude": ["node_modules"]
}
