{
  "uid": "rum-overview",
  "title": "RUM Overview",
  "description": "Real User Monitoring for every UI in the estate, selected by $job. Fed by the shared observability kit; every label is allow-listed server-side because the values come from a browser.",
  "tags": [
    "platform",
    "rum"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 2
      },
      {
        "name": "job",
        "type": "query",
        "label": "UI",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "query": {
          "query": "label_values(rum_navigations_total, job)",
          "refId": "job"
        },
        "refresh": 1,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Core Web Vitals p75",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.75, sum by (le, metric_name) (rate(rum_performance_seconds_bucket{job=\"$job\"}[$__rate_interval])))",
          "legendFormat": "{{metric_name}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ],
      "description": "p75 is the percentile Google grades Core Web Vitals on \u2014 not the mean, and not p95. Good: LCP under 2.5s, INP under 0.2s, TTFB under 0.8s."
    },
    {
      "type": "timeseries",
      "title": "Layout shift p75 (CLS)",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.75, sum by (le) (rate(rum_layout_shift_score_bucket{job=\"$job\"}[$__rate_interval])))",
          "legendFormat": "CLS",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ],
      "description": "Unitless, not seconds. Good under 0.1, poor past 0.25."
    },
    {
      "type": "timeseries",
      "title": "Frustration signals",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "sum by (frustration_type) (rate(rum_frustrations_total{job=\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{frustration_type}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ],
      "description": "Rage clicks, dead clicks, excessive scrolling. A rising line means people cannot do what they came to do \u2014 often before any error rate moves."
    },
    {
      "type": "timeseries",
      "title": "Client errors",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "sum by (error_type) (rate(rum_errors_total{job=\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{error_type}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ],
      "description": "Counts only. The message and stack are deliberately not collected \u2014 diagnosing a specific error is an error tracker's job, and stack traces carry values from the code that threw."
    },
    {
      "type": "timeseries",
      "title": "Interactions",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 17
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "sum by (interaction_type) (rate(rum_interactions_total{job=\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{interaction_type}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ],
      "description": "Clicks, form submits, and the app's own business events."
    },
    {
      "type": "timeseries",
      "title": "Navigation",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 17
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "sum by (navigation_type) (rate(rum_navigations_total{job=\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{navigation_type}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Rejected beacons",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 17
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "sum by (reason) (rate(rum_rejected_total{job=\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{reason}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ],
      "description": "The ingest endpoint is public and unauthenticated by necessity. A sustained `rate_limited` or `unknown_type` line is someone probing it \u2014 this is the one RUM metric whose labels the server controls, so it is safe to alert on."
    },
    {
      "type": "timeseries",
      "title": "Session depth",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(rum_navigation_path_length_bucket{job=\"$job\"}[$__rate_interval])))",
          "legendFormat": "median",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        },
        {
          "expr": "histogram_quantile(0.9, sum by (le) (rate(rum_navigation_path_length_bucket{job=\"$job\"}[$__rate_interval])))",
          "legendFormat": "p90",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ],
      "description": "Pages visited per session. A histogram, not a per-session gauge \u2014 one series per anonymous visitor is unbounded cardinality."
    },
    {
      "type": "timeseries",
      "title": "Vitals by page",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.75, sum by (le, page) (rate(rum_performance_seconds_bucket{job=\"$job\", metric_name=\"LCP\"}[$__rate_interval])))",
          "legendFormat": "{{page}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ],
      "description": "LCP p75 split by route pattern. Pages are normalised \u2014 /pools/:id, never one series per pool."
    }
  ]
}
