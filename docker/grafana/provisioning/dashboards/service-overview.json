{
  "uid": "service-overview",
  "title": "Service Overview",
  "description": "One dashboard for every service, selected by the $job variable. Replaces the per-service copies that had to be hand-edited each time a service was added.",
  "tags": [
    "platform",
    "generated"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 2
      },
      {
        "name": "loki",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 2
      },
      {
        "name": "job",
        "type": "query",
        "label": "Service",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "query": {
          "query": "label_values(up, job)",
          "refId": "job"
        },
        "refresh": 1,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Requests per second",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"$job\"}[$__rate_interval]))",
          "legendFormat": "rps",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ],
      "description": "Empty for a service that does not emit `http_requests_total`. The estate's alerts are built on this metric, so a service missing it is scraped but never alerted on."
    },
    {
      "type": "timeseries",
      "title": "Error ratio (5xx)",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"$job\",status=~\"5..\"}[$__rate_interval]))\n/\nclamp_min(sum(rate(http_requests_total{job=\"$job\"}[$__rate_interval])), 1)",
          "legendFormat": "5xx ratio",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ],
      "description": "The same expression as the PlatformApiHighErrorRate alert, which fires above 2% for 5 minutes."
    },
    {
      "type": "timeseries",
      "title": "Latency p95",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"$job\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        },
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"$job\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ],
      "description": "PlatformApiHighLatencyP95 pages above 300ms for 5 minutes."
    },
    {
      "type": "timeseries",
      "title": "Requests by status",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(http_requests_total{job=\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{status}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total{job=\"$job\"}[$__rate_interval])",
          "legendFormat": "cpu cores",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ],
      "description": "Node's default metrics. Present for every scraped service."
    },
    {
      "type": "timeseries",
      "title": "Resident memory",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "process_resident_memory_bytes{job=\"$job\"}",
          "legendFormat": "rss",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Event loop lag p99",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "nodejs_eventloop_lag_p99_seconds{job=\"$job\"}",
          "legendFormat": "p99",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ],
      "description": "Node services only. A rising lag means the loop is blocked, which shows up as latency long before CPU does."
    },
    {
      "type": "timeseries",
      "title": "Up",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "up{job=\"$job\"}",
          "legendFormat": "scrape ok",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ],
      "description": "Whether Prometheus can scrape /metrics. NOT the same as healthy: a service with a dead database still serves /metrics and still reads 1 here. Health is at /health."
    },
    {
      "type": "logs",
      "title": "Logs",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "description": "Matched on the `app` label, which Alloy promotes from the `service` field of the JSON log line \u2014 the same string as the Prometheus job. Lines carrying a traceId render a 'View trace' link straight into Jaeger.",
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "expr": "{job=\"docker-json-logs\", app=\"$job\"}",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          }
        }
      ]
    }
  ]
}
