#GRAFANA
GRAFANA_ADMIN_USER=platform_ops_grafana_admin
GRAFANA_ADMIN_PASSWORD=SET_FROM_SSM

#TOLGEE
TOLGEE_INITIAL_USERNAME=platform_ops_tolgee_admin
TOLGEE_INITIAL_PASSWORD=SET_FROM_SSM
TOLGEE_JWT_SECRET=SET_FROM_SSM

#CENTRAL_INGRESS
GPOOL_WEB_DOMAIN=gpool.zigordev.com
GPOOL_API_DOMAIN=gpool-api.zigordev.com
OPS_GRAFANA_DOMAIN=grafana.zigordev.com
OPS_TOLGEE_DOMAIN=tolgee.zigordev.com
OPS_OPENBAO_DOMAIN=openbao.zigordev.com

#ALERTING
# Where alerts are delivered, and the relay that carries them. The SMTP username
# and password are secrets and come from SSM at deploy — they are deliberately
# absent here.
SMTP_SMARTHOST=smtp.gmail.com:587
SMTP_FROM=zigordev@gmail.com
ALERT_EMAIL_TO=zigordev@gmail.com
