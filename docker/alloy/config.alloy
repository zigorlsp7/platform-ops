local.file_match "docker_json_logs" {
  path_targets = [
    {
      __path__ = "/var/lib/docker/containers/*/*-json.log",
      job      = "docker-json-logs",
    },
  ]
}

loki.process "docker_json_logs" {
  forward_to = [loki.write.default.receiver]

  stage.json {
    expressions = {
      output  = "log",
      stream  = "stream",
      ts      = "time",
      project = "attrs.\"com.docker.compose.project\"",
      service = "attrs.\"com.docker.compose.service\"",
    }
  }

  stage.timestamp {
    source = "ts"
    format = "RFC3339Nano"
  }

  stage.labels {
    values = {
      project = "project",
      service = "service",
      stream  = "stream",
    }
  }

  stage.output {
    source = "output"
  }

  // Second pass, over the application's own log line rather than Docker's
  // envelope. Services that emit the estate's JSON format carry a `service`
  // field equal to their `OTEL_SERVICE_NAME` — the same string Prometheus uses
  // as `job` and health reports as `service`.
  //
  // Promoting it to a label called `app` is what lets one dashboard query
  // Prometheus and Loki with a single variable.
  //
  // `traceId` is deliberately NOT a label: one stream per trace is unbounded
  // cardinality. It stays in the line, where the Loki datasource's derived
  // field turns it into a link to Jaeger.
  stage.json {
    expressions = {
      app = "service",
    }
  }

  stage.labels {
    values = {
      app = "app",
    }
  }
}

loki.source.file "docker_json_logs" {
  targets               = local.file_match.docker_json_logs.targets
  forward_to            = [loki.process.docker_json_logs.receiver]
  legacy_positions_file = "/var/lib/alloy/data/positions.yaml"
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}